# Required: use independent random values for both secrets.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret
POSTGRES_PASSWORD=replace-with-a-random-password

POSTGRES_USER=famledger
POSTGRES_DB=famledger
POSTGRES_PORT=5432
FAMLEDGER_VERSION=latest
FAMLEDGER_PORT=8000

# true for HTTPS. Set false when accessing the app directly over HTTP.
COOKIE_SECURE=true
# Optional comma-separated trusted frontend origins.
# CORS_ORIGINS=https://ledger.example.com

# Optional bill automation credential: must be bound to an active family.
# FAMLEDGER_API_TOKEN=
# FAMLEDGER_SERVICE_FAMILY_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_TENANT_ID=common
