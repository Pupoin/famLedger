# Required: use independent random values for both secrets.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret
POSTGRES_PASSWORD=replace-with-a-random-password

POSTGRES_USER=famledger
POSTGRES_DB=famledger
POSTGRES_PORT=5432
FAMLEDGER_VERSION=latest
FAMLEDGER_PORT=8000
# Container and log timezone / 容器与日志时区：北京时间 UTC+8。
TZ=Asia/Shanghai
# Use development for local testing without automatic database backups.
FAMLEDGER_ENV=production

# true for HTTPS. Set false when accessing the app directly over HTTP.
COOKIE_SECURE=true
# Optional comma-separated trusted frontend origins.
# CORS_ORIGINS=https://ledger.example.com

# OIDC 私网访问：默认 0 禁用；设为 true 或 1，允许访问受信任的内网认证服务。
# Issuer 仍须使用完整的 https:// 地址，TLS 证书验证和云元数据地址拦截仍然生效。
# 将此项写入实际使用的 .env.docker；修改后需重建容器，单纯 restart 不会更新环境变量：
# docker compose --env-file .env.docker up -d --force-recreate famledger
FAMLEDGER_OIDC_ALLOW_PRIVATE_IPS=0

# Optional server automation credential: must be bound to an active family.
# FAMLEDGER_API_TOKEN=
# FAMLEDGER_SERVICE_FAMILY_ID=
# Mailbridge uses services/mailbridge/.env for its Microsoft and POST credentials.
