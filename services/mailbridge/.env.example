# Mailbridge 配置：拉取与 POST 独立控制；填写目标账号的 API Key 后，再开启 POST。
# 修改本文件后，在本目录执行 docker compose up -d --force-recreate；普通 restart 不会加载新的容器环境变量。
# famLedger 没启动或 POST 失败时，原始邮件保留在 SQLite 中；服务恢复后按下一轮同步自动补推。

# 容器系统及控制台日志时区；Asia/Shanghai 表示北京时间 UTC+8，不改变交易的 UTC 存储时间。
TZ=Asia/Shanghai

# 认证网页允许访问的域名或 IPv4 地址，多个用英文逗号分隔；不填 http(s)://、端口或路径。
# 域名示例：localhost,127.0.0.1,mailbridge.example.com；支持 *.example.com 子域名通配。
# localhost 和 127.0.0.1 始终保留，保证本机访问及容器健康检查；仅填写你实际使用的域名/IP。
MAILBRIDGE_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# 微软 Azure 应用的客户端 ID；应用需启用公共客户端／设备码登录。
# 微软授权窗口的应用名称来自 Azure 应用注册的显示名称，请在“品牌和属性”中设置为 mailbridge。
GRAPH_CLIENT_ID=your-azure-application-client-id

# 微软租户 ID；通常填 common，支持个人和组织账号。
GRAPH_TENANT_ID=common

# 目标微软邮箱；通常填 me，表示当前通过微软授权的用户。
GRAPH_USER_ID=me

# famLedger 后端地址；当前 Docker 服务对宿主机开放 8888，容器内通过 host.docker.internal 访问。
FAMLEDGER_API_URL=http://host.docker.internal:8888

# 新注册用户在 famLedger 设置中创建的个人 API Key；自行填写，勿提交到 Git。
FAMLEDGER_API_TOKEN=

# 拉取邮件开关：true 从微软抓取邮件并保存完整正文到 SQLite，false 暂停微软邮件抓取。
# 拉取不需要 famLedger API Key；关闭此开关不会阻止本地缓存邮件的 POST。
MAILBRIDGE_PULL_ENABLED=true

# POST 开关：true 解析 SQLite 中的邮件并推送给 famLedger，false 只保留邮件、不推送。
# 填好目标用户的 API Key 后再开启；关闭时保留待推、失败、成功和手动重推状态。
MAILBRIDGE_POST_ENABLED=false

# 微软邮箱中的信用卡账单文件夹名称；需与邮箱里的实际文件夹一致。
CREDIT_FOLDER=credits

# 微软邮箱中的借记卡通知文件夹名称；需与邮箱里的实际文件夹一致。
DEBIT_FOLDER=Debit_card

# 信用卡历史回看的天数，例如 50 或 3000；修改数值会重扫一次，已缓存正文不重复下载。
LOOKBACK_DAYS_CREDIT=20

# 借记卡历史回看的天数，例如 50 或 3000；修改数值会重扫一次；单位是天，不是交易笔数。
LOOKBACK_DAYS_DEBIT=20

# 每轮完成后的等待秒数；600 表示等 10 分钟。抓取和 POST 在同一轮执行，失败邮件在下一轮重试。
MAILBRIDGE_SYNC_INTERVAL_SECONDS=600

# 单轮任务最多运行的秒数；1000 表示约 16 分 40 秒。超时终止本轮，下轮从已保存进度继续。
MAILBRIDGE_TASK_TIMEOUT_SECONDS=1000

# 微软登录凭证缓存文件；保留此文件可复用授权，Docker 内路径由 compose 统一设置。
GRAPH_TOKEN_CACHE_PATH=data/msal_token_cache.json

# 独立 SQLite 邮件数据库；保存完整正文、收发信息、同步进度和推送状态，不要删除 data 目录。
MAILBRIDGE_DATABASE_PATH=data/mailbridge.db

# 控制台日志级别，可填 DEBUG、INFO、WARNING 或 ERROR；不创建 logs 目录或文件日志。
LOG_LEVEL=INFO

# 手动重推：平时留空；10d@20261004-1 重推操作时刻过去 10 天的交易，all@20261004-1 重推全部缓存。
# @ 后是本次操作标记，再次重推请改成新的值（如 10d@20261004-2）；同一值中途重启会续传。
# 天数按交易发生时间筛选，不按邮件收件日期；正常失败邮件仍按原队列重试。
# 仅 POST 开启时执行并记录标记；POST 关闭期间不触发，重新开启时开始或继续。
# PULL 关闭时只读取已有 SQLite 缓存；重推不会强制开启拉取，也不会绕过 POST 开关。
# 10d 的时间范围在 POST 首次执行该标记时固定，而不是写入 .env 时固定。
MAILBRIDGE_REPLAY=
