# Secret key for signing session cookies (use a long random string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-key

# ── Production settings ───────────────────────────────────────────────────────

# Set to "production" to enable production logging and behaviour.
# Leave as "development" (default) for local dev.
# ENV=production

# Override cookie Secure flag independently of ENV.
# Set to "false" for HTTP-only (local network) deployments without HTTPS.
# Set to "true" for HTTPS deployments.
# If unset, defaults to: false when ENV=development, true when ENV=production.
# COOKIE_SECURE=false

# Comma-separated list of allowed CORS origins.
# Not needed in either deployment: FastAPI serves the built frontend itself, so
# the UI and API always share an origin (there is no nginx in the Docker image).
# Only needed if you put the UI on a different origin to the API.
# Defaults to http://localhost:5173 for local development.
# CORS_ORIGINS=http://localhost:5173

# Directory for database, backups, audit logs, and avatar uploads.
# Defaults to the backend/ directory.
# In Docker, this is set to /app/data (a mounted volume) automatically.
# DATA_DIR=/app/data

# ── Optional backup settings ─────────────────────────────────────────────────

# An ADDITIONAL destination for backups — e.g. a OneDrive/cloud-synced folder.
#
# Backups always land in DATA_DIR/backups/ first; this is a mirror, not a
# replacement. Changed in v2.1.0: previously this variable *relocated* backups,
# so setting it silently switched local backups off, and pointing it at a path
# that wasn't mounted made Mosaic create a plain directory there and log
# "Backup created and verified" while nothing ever synced. The path is now never
# created, and a missing or unwritable target stops the app at startup.
# BACKUP_PATH=C:/Users/yourname/OneDrive/Mosaic-Backups

# Require BACKUP_PATH to be a real mountpoint, so an unmounted network/FUSE
# volume is fatal rather than silently filling local disk. Leave unset for an
# OS-level sync folder (the OneDrive or Dropbox client), which is a plain
# directory and would fail this check.
# BACKUP_REQUIRE_MOUNT=true

# How many timestamped backups to retain before old ones are rotated out.
# Defaults to 30.
# MAX_BACKUPS=30

# Trigger an extra backup every N audited mutations (create/update/delete/etc),
# in addition to the one taken at startup — so backups stay correlated with
# actual data change on a long-running container, not just process restarts.
# Defaults to 20.
# BACKUP_EVERY_N_MUTATIONS=20
